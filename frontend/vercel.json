{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/fk-catering/browser",
  "functions": {
    "api/ssr.mjs": {
      "includeFiles": "dist/fk-catering/server/**"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/ssr" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/ssr" }
  ]
}
