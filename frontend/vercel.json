{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/fk-catering/browser",
  "functions": {
    "api/ssr.mjs": {
      "includeFiles": "dist/fk-catering/server/**"
    }
  },
  "routes": [
    {
      "src": "/api/(auth|persons|products|categories|brands|cart|quotes|admin|health)(/.*)?",
      "dest": "https://catering-4uyr.onrender.com/api/$1$2"
    },
    { "src": "/", "dest": "/api/ssr" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/ssr" }
  ]
}
