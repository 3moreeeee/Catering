# Repository-wide rules. frontend/ and backend/ each carry their own
# .gitignore for build output specific to their toolchain.

# Environment files: real secrets never leave this machine. Templates stay.
.env
.env.*
!.env.example

# Agent / tooling workspaces — local only.
.claude/
.codex/
graphify-out/

# Logs.
*.log

# IDEs and editors
.idea/
*.iml
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# System files
.DS_Store
Thumbs.db
