{
  "name": "fk-catering",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/generate-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:fk-catering": "node dist/fk-catering/server/server.mjs",
    "build:only": "ng build",
    "assets": "node scripts/generate-assets.mjs && node scripts/generate-placeholder-art.mjs",
    "fetch:images": "node scripts/fetch-legacy-images.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "ng build --stats-json && npx esbuild-visualizer --metadata dist/fk-catering/stats.json --open",
    "art": "node scripts/generate-placeholder-art.mjs",
    "images:normalize": "node scripts/normalize-product-images.mjs",
    "images:products": "node scripts/prepare-product-images.mjs",
    "media:imagekit": "node scripts/migrate-media-to-imagekit.mjs"
  },
  "private": true,
  "packageManager": "npm@11.3.0",
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@jsverse/transloco": "^8.4.0",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "pg": "^8.23.0",
    "rxjs": "~7.8.0",
    "swiper": "^14.0.7",
    "three": "^0.185.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/three": "^0.185.4",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.8"
  }
}
