# Template for .env. Copy to .env and fill in real values; never commit .env.
# Spring has no native .env support: DotenvEnvironmentPostProcessor reads this
# file, and a real environment variable of the same name always takes priority.

# Neon supplies both from its Connect dialog. The pooled host carries the
# "-pooler" infix and is what the application runs against; the direct host is
# the same name without it, for migrations and bulk loads.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-strong-password
# ImageKit stores heavy images/videos; Neon stores the returned public URLs.
# The private key is server/tooling-only and must never be exposed to Angular.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

APP_CORS_ORIGINS=https://your-frontend.example.com

# Production only (set on the host, not in .env): activates application-prod.yml
# and ProductionConfigurationGuard, which refuses to start without PostgreSQL or a
# stable APP_JWT_SECRET instead of falling back to H2 or a random secret.
# SPRING_PROFILES_ACTIVE=prod
APP_SECURE_COOKIE=true
APP_CATALOG_SEED=true
